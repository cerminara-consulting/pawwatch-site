---
import Layout from "../layouts/Layout.astro";
import { Content } from "../content-docs/privacy-policy.md";
---

<Layout
  title="Privacy Policy — PawWatch"
  description="PawWatch privacy policy. What we collect, how we use it, and your rights."
>
  <section class="wrap-narrow prose">
    <Content />
  </section>
</Layout>

<style>
  /*
   * The copy comes from src/content-docs/privacy-policy.md, which is
   * synced from the iOS repo. The markdown owns the words; this only
   * styles them.
   *
   * The date line is the first paragraph after the title. The markdown
   * says "Last updated 2026-11-20"; the old hand-written page had it
   * in a styled element, so it keeps that look.
   */
  section > h1 + p {
    font-size: 0.875rem;
    color: var(--ink-soft);
    font-style: italic;
    margin-bottom: 1.5em;
  }
</style>
