---
import Layout from "../layouts/Layout.astro";
import PhoneMockup from "../components/PhoneMockup.astro";
---

<Layout
  title="Paw Watch — Community-powered safety for dog walkers"
  description="Paw Watch is a community-powered safety app for dog walkers. See local hazards, submit reports, and walk with confidence. Built by Cerminara Consulting."
>
  <section class="wrap hero">
    <div class="hero-grid">
      <div class="hero-text">
        <span class="hero-eyebrow">Paw Watch for iPhone</span>
        <h1>Walk with confidence.</h1>
        <p class="lede">
          Paw Watch is a community-powered safety app for dog walkers. See
          local hazards — loose dogs, broken sidewalks, poor lighting, off-leash
          trouble — submit 30-second reports when you spot something, and get
          alerts when a new hazard shows up near your favorite routes.
        </p>
        <p class="lede">
          Available on the App Store.
        </p>
        <p class="hero-links">
          <a href="/privacy-policy/" class="link-arrow">Privacy Policy</a>
          <span aria-hidden="true">·</span>
          <a href="/support/" class="link-arrow">Support</a>
        </p>
      </div>
      <div class="hero-visual">
        <PhoneMockup />
      </div>
    </div>
  </section>

  <section class="wrap features">
    <h2 class="visually-hidden">Features</h2>
    <div class="feature-grid">
      <div class="feature">
        <span class="feature-icon" aria-hidden="true">📍</span>
        <h3>Live hazards map</h3>
        <p>
          Color-coded pins show nearby hazards at a glance. Tap for
          detail — category, severity, recent confirmations, and time
          until auto-expire.
        </p>
      </div>
      <div class="feature">
        <span class="feature-icon" aria-hidden="true">⏱️</span>
        <h3>30-second reports</h3>
        <p>
          Eight categories, three severities. Submit a report in the
          time it takes to tie a loose leash.
        </p>
      </div>
      <div class="feature">
        <span class="feature-icon" aria-hidden="true">🔔</span>
        <h3>Home radius alerts</h3>
        <p>
          Set a center point and a radius. Get a push notification when
          a new hazard is reported within your watch area.
        </p>
      </div>
      <div class="feature">
        <span class="feature-icon" aria-hidden="true">🐕</span>
        <h3>Walk tracking</h3>
        <p>
          Start a walk, log the route and distance, and review your
          history. Multi-pet walks are supported.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap about">
    <h2>About Paw Watch</h2>
    <p>
      Paw Watch is built and published by Cerminara Consulting LLC, a
      Virginia-based independent consulting practice. We build software
      for problems where every user story has to survive a compliance
      review — feels like overkill for a dog-walking app, which is
      exactly the point. Paw Watch is the dog-walking app we built
      with that same discipline.
    </p>
    <p>
      Questions? Reach out at
      <a href="mailto:hello@paw-watch.app">hello@paw-watch.app</a>.
    </p>
  </section>
</Layout>

<style>
  .hero {
    padding: 60px 0 40px;
    border-bottom: 1px solid var(--rule);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .hero-text {
    max-width: 560px;
  }
  .hero-visual {
    display: flex;
    justify-content: center;
  }
  .phone-mockup {
    width: 100%;
    max-width: 280px;
    height: auto;
    filter: drop-shadow(0 30px 60px rgba(24, 61, 98, 0.18));
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--teal);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 3.4rem);
    margin: 0 0 16px;
    line-height: 1.05;
  }
  .hero .lede {
    color: var(--ink-soft);
    margin: 0 0 1em;
    font-size: 1.05rem;
  }
  .hero-links {
    margin-top: 24px;
    font-weight: 500;
  }
  .hero-links a {
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
    margin-right: 8px;
  }
  .hero-links a:hover {
    border-bottom-color: var(--navy);
  }

  .features {
    padding: 64px 0 32px;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }
  .feature {
    background: white;
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 22px 24px;
  }
  .feature-icon {
    display: inline-block;
    font-size: 1.75rem;
    margin-bottom: 8px;
    line-height: 1;
  }
  .feature h3 {
    margin: 0 0 8px;
    font-size: 1.1rem;
  }
  .feature p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .about {
    padding: 48px 0 60px;
    max-width: 640px;
  }
  .about p {
    color: var(--ink-soft);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-text {
      max-width: 100%;
    }
    .hero-visual {
      order: -1;
    }
  }
  @media (max-width: 600px) {
    .hero h1 { font-size: 2.25rem; }
  }
</style>
</content>
