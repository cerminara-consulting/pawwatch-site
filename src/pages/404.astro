---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found — Paw Watch"
  description="The page you were looking for doesn't exist."
>
  <section class="wrap centered">
    <h1>404</h1>
    <p class="lede">
      That page doesn't exist (or doesn't anymore).
    </p>
    <p>
      Try the <a href="/home/">homepage</a>,
      the <a href="/privacy-policy/">privacy policy</a>,
      or the <a href="/support/">support page</a>.
    </p>
  </section>
</Layout>

<style>
  .centered {
    text-align: center;
    padding: 80px 0;
  }
  .lede {
    font-size: 1.125rem;
    color: var(--ink-soft);
    margin-bottom: 1.5em;
  }
  h1 {
    font-size: 4rem;
    margin: 0;
  }
</style>
</invoke>
