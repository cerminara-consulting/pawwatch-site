---
import Layout from "../layouts/Layout.astro";
import { Content } from "../content-docs/support.md";
---

<Layout
  title="Support — PawWatch"
  description="Get help with PawWatch. Contact us, read FAQs, and find resources."
>
  <section class="wrap-narrow prose">
    <Content />
  </section>
</Layout>

<style>
  /*
   * The copy comes from src/content-docs/support.md, which is synced
   * from the iOS repo. The markdown owns the words; this only styles
   * them.
   *
   * The first paragraph after the title is the introduction. The old
   * hand-written page had it as a lede.
   */
  section > h1 + p {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin-bottom: 1.5em;
  }
</style>
